{
  "name": "resonance-industrielle",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build.mjs && node scripts/standalone.mjs && node scripts/site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "balance": "node scripts/balance.mjs",
    "start": "node scripts/server.mjs",
    "standalone": "node scripts/standalone.mjs",
    "site": "node scripts/site.mjs",
    "campaign": "node scripts/campaign.mjs",
    "e2e": "node scripts/e2e.mjs",
    "i18n": "node scripts/i18n-audit.mjs",
    "android": "node scripts/standalone.mjs && cd android && ./gradlew assembleRelease",
    "ux": "node scripts/ux-first-run.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "happy-dom": "^21.0.4",
    "typescript": "5.9.3"
  }
}
